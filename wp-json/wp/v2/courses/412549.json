{"id":412549,"date":"2026-06-15T11:03:45","date_gmt":"2026-06-15T05:03:45","guid":{"rendered":"https:\/\/rifatacademy.com\/?post_type=courses&#038;p=412549"},"modified":"2026-06-15T11:03:45","modified_gmt":"2026-06-15T05:03:45","slug":"mobile-gfx-mastry-premium-recorded-batch","status":"publish","type":"courses","link":"https:\/\/rifatacademy.com\/courses\/mobile-gfx-mastry-premium-recorded-batch\/","title":{"rendered":"Mobile Gfx Mastry (Premium Recorded Batch)"},"content":{"rendered":"<pre class=\"a-b-r-La\">\ud83d\ude80 \u09aa\u09bf\u09b8\u09bf \u09ac\u09be \u09b2\u09cd\u09af\u09be\u09aa\u099f\u09aa \u09a8\u09c7\u0987 \u09ac\u09b2\u09c7 \u0995\u09bf \u09b8\u09cd\u09ac\u09aa\u09cd\u09a8 \u09a5\u09c7\u09ae\u09c7 \u09af\u09be\u09ac\u09c7?\r\n\r\n\u0986\u099c\u0995\u09c7\u09b0 \u09af\u09c1\u0997\u09c7 \u0997\u09cd\u09b0\u09be\u09ab\u09bf\u0995 \u09a1\u09bf\u099c\u09be\u0987\u09a8\u09be\u09b0 \u09b9\u0993\u09df\u09be\u09b0 \u09b8\u09cd\u09ac\u09aa\u09cd\u09a8 \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09bf\u09b8\u09bf \u09ac\u09be \u09b2\u09cd\u09af\u09be\u09aa\u099f\u09aa \u09a5\u09be\u0995\u09be \u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be\u09ae\u09c2\u09b2\u0995 \u09a8\u09df\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b9\u09be\u09a4\u09c7\u09b0 \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f\u09ab\u09cb\u09a8\u0987 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09b8\u09cd\u099f\u09c1\u09a1\u09bf\u0993, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u0985\u09ab\u09bf\u09b8, \u0986\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u0987\u09a8\u0995\u09be\u09ae \u09b8\u09cb\u09b0\u09cd\u09b8\u0964\r\n\u0985\u09a8\u09c7\u0995\u09c7\u0987 \u09ad\u09be\u09ac\u09c7 \u201c\u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0 \u09a8\u09c7\u0987, \u09a4\u09be\u0987 \u0986\u09ae\u09bf \u09aa\u09bf\u099b\u09bf\u09df\u09c7 \u0986\u099b\u09bf\u0964\u201d \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09b8\u09b2 \u09b8\u09a4\u09cd\u09af \u09b9\u09b2\u09cb, \u09b8\u09a0\u09bf\u0995 \u0997\u09be\u0987\u09a1\u09b2\u09be\u0987\u09a8 \u0986\u09b0 \u09aa\u09cd\u09b0\u09cd\u09af\u09be\u0995\u099f\u09bf\u0995\u09cd\u09af\u09be\u09b2 \u099f\u09cd\u09b0\u09c7\u09a8\u09bf\u0982 \u09a5\u09be\u0995\u09b2\u09c7 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a6\u09bf\u09df\u09c7\u0987 \u0986\u09aa\u09a8\u09bf \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09ac\u09c7\u09a8 \u09aa\u09cd\u09b0\u09ab\u09c7\u09b6\u09a8\u09be\u09b2 \u0997\u09cd\u09b0\u09be\u09ab\u09bf\u0995 \u09a1\u09bf\u099c\u09be\u0987\u09a8\u09bf\u0982 \u0995\u09cd\u09af\u09be\u09b0\u09bf\u09df\u09be\u09b0\u0964\r\n\u098f\u0987 \u0985\u099c\u09c1\u09b9\u09be\u09a4\u0995\u09c7 \u099a\u09bf\u09b0\u09a4\u09b0\u09c7 \u09ae\u09c1\u099b\u09c7 \u09a6\u09bf\u09a4\u09c7 Rifat IT Institute \u09a8\u09bf\u09df\u09c7 \u098f\u09b8\u09c7\u099b\u09c7  \ud83d\udc49Mobile GFX Mastery Premium Recorded Batch With Taskin Vaiya\r\n\r\n\ud83c\udfaf \u0995\u09cb\u09b0\u09cd\u09b8\u09c7\u09b0 \u09ae\u09c2\u09b2 \u09b2\u0995\u09cd\u09b7\u09cd\u09af\r\n\r\n\u26aa\u0986\u09aa\u09a8\u09be\u09b0 \u09b9\u09be\u09a4\u09c7\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a6\u09bf\u09df\u09c7\u0987 \u09aa\u09cd\u09b0\u09ab\u09c7\u09b6\u09a8\u09be\u09b2 \u09b8\u09cd\u0995\u09bf\u09b2 \u09b6\u09c7\u0996\u09be\u09a8\u09cb\r\n\u26aa\u09b0\u09bf\u09df\u09c7\u09b2-\u09b2\u09be\u0987\u09ab \u09aa\u09cd\u09b0\u099c\u09c7\u0995\u09cd\u099f\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09be\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09a6\u09c7\u0993\u09df\u09be\r\n\u26aa\u09ab\u09cd\u09b0\u09bf\u09b2\u09cd\u09af\u09be\u09a8\u09cd\u09b8\u09bf\u0982 \u0993 \u0995\u09cd\u09b2\u09be\u09df\u09c7\u09a8\u09cd\u099f \u09b9\u09be\u09a8\u09cd\u099f\u09bf\u0982 \u09b6\u09c7\u0996\u09be\u09a8\u09cb\r\n\u26aa\u09af\u09be\u09a4\u09c7 \u0986\u09aa\u09a8\u09bf \u0986\u09df \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09c7 \u09a8\u09bf\u099c\u09c7\u09b0 \u0987\u09a8\u0995\u09be\u09ae \u09a6\u09bf\u09df\u09c7 \u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0 \u0995\u09bf\u09a8\u09c7 \u0986\u09b0\u0993 \u09ac\u09dc \u09b8\u09cd\u0995\u09bf\u09b2 \u09b6\u09bf\u0996\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\r\n\r\n\u2705 \u0995\u09cb\u09b0\u09cd\u09b8\u09c7 \u09af\u09be \u09aa\u09be\u099a\u09cd\u099b\u09c7\u09a8\r\n\r\n\u26aa\u09ea\u09eb+ \u09b0\u09c7\u0995\u09b0\u09cd\u09a1\u09c7\u09a1 \u0995\u09cd\u09b2\u09be\u09b8 \u2192 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09ae\u09c7\u09a8\u09cd\u099f\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b6\u09c7\u0996\u09be\u09b0 \u09b8\u09c1\u09af\u09cb\u0997\r\n\u26aa\u09b8\u09ae\u09df\u09b8\u09c0\u09ae\u09be \u0993 \u09b0\u09c1\u099f\u09bf\u09a8 \u2192 \u09e8 \u09ae\u09be\u09b8\u09c7\u09b0 \u0995\u09ae\u09aa\u09cd\u09b2\u09bf\u099f \u0995\u09cb\u09b0\u09cd\u09b8, \u09aa\u09cd\u09b0\u09a4\u09bf\u09a8\u09bf\u09af\u09bc\u09a4 \u09ad\u09bf\u09a1\u09bf\u0993 \u098f\u09a1 \u09b9\u09a4\u09c7 \u09a5\u09be\u0995\u09ac\u09c7\r\n\u26aa\u09ec\u099f\u09bf \u09b8\u09cd\u09aa\u09c7\u09b6\u09be\u09b2 \u09ae\u09a1\u09bf\u0989\u09b2 \u2192 \u0995\u09be\u09b2\u09be\u09b0 \u0993 \u09ab\u09a8\u09cd\u099f \u09a5\u09bf\u0993\u09b0\u09bf, \u09aa\u09cd\u09b0\u09ab\u09c7\u09b6\u09a8\u09be\u09b2 \u09aa\u09cb\u09b8\u09cd\u099f\u09be\u09b0 \u0993 \u09a5\u09be\u09ae\u09cd\u09ac\u09a8\u09c7\u0987\u09b2 \u09a1\u09bf\u099c\u09be\u0987\u09a8,\u09b2\u09cb\u0997\u09cb \u098f\u09ac\u0982 \u09ac\u09cd\u09b0\u09cd\u09af\u09be\u09a8\u09cd\u09a1\u09bf\u0982 \u09a1\u09bf\u099c\u09be\u0987\u09a8, \u09ac\u09c1\u0995 \u0995\u09ad\u09be\u09b0 \u09a1\u09bf\u099c\u09be\u0987\u09a8, \u09ac\u09bf\u099c\u09a8\u09c7\u09b8 \u0995\u09be\u09b0\u09cd\u09a1 \u09a1\u09bf\u099c\u09be\u0987\u09a8, AI \u09a1\u09bf\u099c\u09be\u0987\u09a8, \u0995\u09cd\u09b2\u09be\u09df\u09c7\u09a8\u09cd\u099f \u09b9\u09be\u09a8\u09cd\u099f\u09bf\u0982,\r\n\u26aa\u09e9\u09e6+ \u09aa\u09cd\u09b0\u09cd\u09af\u09be\u0995\u099f\u09bf\u0995\u09cd\u09af\u09be\u09b2 \u09aa\u09cd\u09b0\u099c\u09c7\u0995\u09cd\u099f \u2192 \u09b9\u09be\u09a4\u09c7-\u0995\u09b2\u09ae\u09c7 \u09b0\u09bf\u09df\u09c7\u09b2-\u09b2\u09be\u0987\u09ab \u09a1\u09bf\u099c\u09be\u0987\u09a8\r\n\r\n\ud83c\udf81 \u09ae\u09c7\u099f\u09c7\u09b0\u09bf\u09df\u09be\u09b2\u09b8 \u0993 \u09ac\u09cb\u09a8\u09be\u09b8\r\n\r\n\ud83d\udd37Premium Apps \u2192 Canva, Ibis Paint X, Pixellab, Lightroom, Snapseed (\u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09df\u09be\u09ae \u09ad\u09be\u09b0\u09cd\u09b8\u09a8 \u09ab\u09cd\u09b0\u09bf)\r\n\ud83d\udd37Premium Assets \u2192 \u09ab\u09a8\u09cd\u099f, \u09ac\u09cd\u09af\u09be\u0995\u0997\u09cd\u09b0\u09be\u0989\u09a8\u09cd\u09a1, PNG \u098f\u09b2\u09bf\u09ae\u09c7\u09a8\u09cd\u099f\u09c7\u09b0 \u09ac\u09bf\u09b6\u09be\u09b2 \u0995\u09be\u09b2\u09c7\u0995\u09b6\u09a8\r\n\ud83d\udd37Double-Solving Class \u2192 \u09aa\u09cd\u09b0\u09a4\u09bf\u099f\u09bf \u09ae\u09a1\u09bf\u0989\u09b2 \u09b6\u09c7\u09b7\u09c7 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09b8\u09ae\u09be\u09a7\u09be\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09ac\u09bf\u09b6\u09c7\u09b7 \u0995\u09cd\u09b2\u09be\u09b8\r\n\r\n\ud83d\udc68\u200d\ud83c\udfeb \u0987\u09a8\u09b8\u09cd\u099f\u09cd\u09b0\u09be\u0995\u09cd\u099f\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2\r\n\r\n\ud83d\udfe1\u09a4\u09be\u09b8\u0995\u09bf\u09a8 \u0986\u09b9\u09ae\u09c7\u09a6 \u0986\u09b2\u09bf\u09ab \u2192 \u09ec+ \u09ac\u099b\u09b0\u09c7\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u0997\u09cd\u09b0\u09be\u09ab\u09bf\u0995\u09cd\u09b8 \u09a1\u09bf\u099c\u09be\u0987\u09a8 \u098f\u09ac\u0982 \u09ad\u09bf\u09a1\u09bf\u0993 \u098f\u09a1\u09bf\u099f\u09bf\u0982 \u09b8\u09c7\u0995\u09cd\u099f\u09b0\u09c7, \u09ec\u09e6\u09e6+ \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0\u09cd\u09a5\u09c0\u0995\u09c7 \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u0997\u09be\u0987\u09a1 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\r\n\ud83d\udfe1\u09b6\u09be\u0995\u09bf\u09ac\u09c1\u09b2 \u09b9\u09be\u09b8\u09be\u09a8 \u09b0\u09bf\u09ab\u09be\u09a4 \u2192 \u09e9+ \u09ac\u099b\u09b0\u09c7\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09ad\u09bf\u09a1\u09bf\u0993 \u098f\u09a1\u09bf\u099f\u09bf\u0982 \u09b8\u09c7\u0995\u09cd\u099f\u09b0\u09c7, \u09eb+ \u09ac\u099b\u09b0\u09c7\u09b0 \u09ae\u09be\u09b0\u09cd\u0995\u09c7\u099f\u09bf\u0982 \u098f\u0995\u09cd\u09b8\u09aa\u09c7\u09b0\u09bf\u09af\u09bc\u09c7\u09a8\u09cd\u09b8\u09a1 \u09e7\u09e6\u09e6+ \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0\u09cd\u09a5\u09c0\u0995\u09c7 \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u0997\u09be\u0987\u09a1 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\r\n\r\n\ud83e\udd1d \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09b8\u09be\u09aa\u09cb\u09b0\u09cd\u099f\r\n\r\n\u26aa\u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09df \u09ae\u09c7\u09a8\u09cd\u099f\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09ae\u09c7\u09b8\u09c7\u099e\u09cd\u099c\u09be\u09b0\u09c7 \u0995\u09a5\u09be \u09ac\u09b2\u09be\u09b0 \u09b8\u09c1\u09af\u09cb\u0997\r\n\u26aa\u09ae\u09c7\u09a8\u09cd\u099f\u09b0 \u09a8\u09bf\u099c\u09c7\u0987 \u09b0\u09bf\u09aa\u09cd\u09b2\u09be\u0987 \u09a6\u09c7\u09ac\u09c7\u09a8, \u0995\u09cb\u09a8\u09cb \u0985\u099f\u09cb-\u09b0\u09bf\u09aa\u09cd\u09b2\u09be\u0987 \u09a8\u09df\r\n\r\n\u23f3 \u0985\u09ab\u09be\u09b0 \u0993 \u09ad\u09b0\u09cd\u09a4\u09bf \u09a8\u09bf\u09df\u09ae\r\n\r\n\ud83d\udcb0 \u0985\u09ab\u09be\u09b0 \u09aa\u09cd\u09b0\u09be\u0987\u09b8: \u09ae\u09be\u09a4\u09cd\u09b0 \u09e7,\u09eb\u09e9\u09e6\/= \u099f\u09be\u0995\u09be (\u09b0\u09c7\u0997\u09c1\u09b2\u09be\u09b0 \u09e9,\u09e9\u09ec\u09e6\/= \u099f\u09be\u0995\u09be)\r\n\ud83d\udcde \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u0995\u09a5\u09be \u09ac\u09b2\u09a4\u09c7 \u0995\u09b2 \u0995\u09b0\u09c1\u09a8:09611-900584\r\n\r\n\ud83d\ude80 \u0995\u09c7\u09a8 \u098f\u0996\u09a8\u0987 \u09ad\u09b0\u09cd\u09a4\u09bf \u09b9\u09ac\u09c7\u09a8?\r\n\r\n\ud83d\udd37\u09b8\u09c0\u09ae\u09bf\u09a4 \u0986\u09b8\u09a8, \u0985\u09ab\u09be\u09b0 \u09b6\u09c7\u09b7 \u09b9\u09df\u09c7 \u0997\u09c7\u09b2\u09c7 \u09b0\u09c7\u0997\u09c1\u09b2\u09be\u09b0 \u09aa\u09cd\u09b0\u09be\u0987\u09b8\u09c7 \u09ad\u09b0\u09cd\u09a4\u09bf \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7\r\n\ud83d\udd37\u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a6\u09bf\u09df\u09c7\u0987 \u09ab\u09cd\u09b0\u09bf\u09b2\u09cd\u09af\u09be\u09a8\u09cd\u09b8\u09bf\u0982 \u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09be\u09b0 \u09b8\u09c7\u09b0\u09be \u09b8\u09c1\u09af\u09cb\u0997\r\n\ud83d\udd37\u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09df\u09be\u09ae \u0985\u09cd\u09af\u09be\u09aa\u09b8 \u0993 \u0985\u09cd\u09af\u09be\u09b8\u09c7\u099f\u09b8 \u09ab\u09cd\u09b0\u09bf \u09aa\u09be\u099a\u09cd\u099b\u09c7\u09a8\r\n\ud83d\udd37\u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09ae\u09c7\u09a8\u09cd\u099f\u09b0\u09c7\u09b0 \u09b8\u09be\u09aa\u09cb\u09b0\u09cd\u099f\r\n\ud83d\udc49 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u099c\u09c1\u09b9\u09be\u09a4 \u09ad\u09c7\u0999\u09c7 \u09a8\u09bf\u099c\u09c7\u0995\u09c7 \u09a6\u0995\u09cd\u09b7 \u0995\u09b0\u09c7 \u0997\u09dc\u09c7 \u09a4\u09cb\u09b2\u09be\u09b0 \u098f\u099f\u09be\u0987 \u09b8\u09c7\u09b0\u09be \u09b8\u09ae\u09df\u0964 \u0986\u099c\u0987 \u09b6\u09c1\u09b0\u09c1 \u09b9\u09cb\u0995 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09a4\u09c1\u09a8 \u09aa\u09a5\u099a\u09b2\u09be!\r\n\r\n\ud83d\udce9 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09cb:\r\n\r\n\ud83d\udccd \u0997\u09cd\u09b0\u09be\u09ab\u09bf\u0995\u09cd\u09b8 \u09a1\u09bf\u099c\u09be\u0987\u09a8 (\u09a4\u09be\u09b8\u0995\u09bf\u09a8 \u0986\u09b9\u09ae\u09c7\u09a6): https:\/\/www.facebook.com\/taskin.ahmed.alif.2024\r\n\ud83d\udccd \u09ad\u09bf\u09a1\u09bf\u0993 \u098f\u09a1\u09bf\u099f\u09bf\u0982 (\u09b6\u09be\u0995\u09bf\u09ac\u09c1\u09b2 \u09b9\u09be\u09b8\u09be\u09a8): https:\/\/www.facebook.com\/profile.php?id=61584472713807<\/pre>\n","protected":false},"excerpt":{"rendered":"<p>\ud83d\ude80 \u09aa\u09bf\u09b8\u09bf \u09ac\u09be \u09b2\u09cd\u09af\u09be\u09aa\u099f\u09aa \u09a8\u09c7\u0987 \u09ac\u09b2\u09c7 \u0995\u09bf \u09b8\u09cd\u09ac\u09aa\u09cd\u09a8 \u09a5\u09c7\u09ae\u09c7 \u09af\u09be\u09ac\u09c7? \u0986\u099c\u0995\u09c7\u09b0 \u09af\u09c1\u0997\u09c7 \u0997\u09cd\u09b0\u09be\u09ab\u09bf\u0995 \u09a1\u09bf\u099c\u09be\u0987\u09a8\u09be\u09b0 \u09b9\u0993\u09df\u09be\u09b0 \u09b8\u09cd\u09ac\u09aa\u09cd\u09a8 \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09a4\u09c7 \u09aa\u09bf\u09b8\u09bf \u09ac\u09be \u09b2\u09cd\u09af\u09be\u09aa\u099f\u09aa \u09a5\u09be\u0995\u09be \u09ac\u09be\u09a7\u09cd\u09af\u09a4\u09be\u09ae\u09c2\u09b2\u0995 \u09a8\u09df\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09b9\u09be\u09a4\u09c7\u09b0 \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f\u09ab\u09cb\u09a8\u0987 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u09b8\u09cd\u099f\u09c1\u09a1\u09bf\u0993, \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u0985\u09ab\u09bf\u09b8, \u0986\u09b0 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09a5\u09ae \u0987\u09a8\u0995\u09be\u09ae \u09b8\u09cb\u09b0\u09cd\u09b8\u0964 \u0985\u09a8\u09c7\u0995\u09c7\u0987 \u09ad\u09be\u09ac\u09c7 \u201c\u0995\u09ae\u09cd\u09aa\u09bf\u0989\u099f\u09be\u09b0 \u09a8\u09c7\u0987, \u09a4\u09be\u0987 \u0986\u09ae\u09bf \u09aa\u09bf\u099b\u09bf\u09df\u09c7 \u0986\u099b\u09bf\u0964\u201d \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u09b8\u09b2 \u09b8\u09a4\u09cd\u09af \u09b9\u09b2\u09cb, \u09b8\u09a0\u09bf\u0995 \u0997\u09be\u0987\u09a1\u09b2\u09be\u0987\u09a8 \u0986\u09b0&#8230;<\/p>\n","protected":false},"author":3725,"featured_media":412494,"template":"","meta":{"_kad_post_transparent":"","_kad_post_title":"","_kad_post_layout":"","_kad_post_sidebar_id":"","_kad_post_content_style":"","_kad_post_vertical_padding":"","_kad_post_feature":"","_kad_post_feature_position":"","_kad_post_header":false,"_kad_